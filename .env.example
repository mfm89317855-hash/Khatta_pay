# GEMINI_API_KEY: Optional for cloud Gemini transcription & Live voice API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY / WHISPER_API_KEY: Optional for cloud OpenAI Whisper audio transcription
OPENAI_API_KEY="your-openai-whisper-api-key-here"

# KHATATALK_MODEL: Local Ollama model (default: qwen2.5:3b or qwen3.8:27b)
KHATATALK_MODEL="qwen2.5:3b"

# OLLAMA_HOST: Local Ollama server endpoint (default: http://localhost:11434)
OLLAMA_HOST="http://localhost:11434"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
